{
  "name": "investment-os",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b",
    "api:dev": "pnpm --filter @investment-os/api dev",
    "api:start": "pnpm --filter @investment-os/api start",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:dev": "pnpm --filter @investment-os/db seed:dev",
    "market:refresh": "pnpm --filter @investment-os/api market:refresh",
    "alerts:run": "pnpm --filter @investment-os/worker alerts:run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
